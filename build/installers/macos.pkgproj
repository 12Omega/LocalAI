            line-height: 1.5;
        }
        h1 { 
            color: #007AFF;
            font-size: 22px;
            margin-bottom: 16px;
        }
        p { margin: 8px 0; }
        strong { font-weight: 600; }
        .success { 
            color: #34C759;
            font-weight: 600;
        }
    &lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;h1&gt;Installation Complete&lt;/h1&gt;
    &lt;p class="success"&gt;✓ Local AI Development Environment has been successfully installed.&lt;/p&gt;
    &lt;p&gt;The application has been installed to your Applications folder. You can:&lt;/p&gt;
    &lt;ul&gt;
        &lt;li&gt;Launch it from your Applications folder&lt;/li&gt;
        &lt;li&gt;Find it using Spotlight search (Cmd+Space, type "Local AI")&lt;/li&gt;
        &lt;li&gt;Add it to your Dock for quick access&lt;/li&gt;
    &lt;/ul&gt;
    &lt;p&gt;&lt;strong&gt;Getting Started:&lt;/strong&gt;&lt;/p&gt;
    &lt;ol&gt;
        &lt;li&gt;Launch Local AI Development Environment&lt;/li&gt;
        &lt;li&gt;Configure your LLM settings in the Settings panel&lt;/li&gt;
        &lt;li&gt;Enter a task description and click Run to get started&lt;/li&gt;
    &lt;/ol&gt;
    &lt;p&gt;For documentation and support, visit the project repository or check the Help menu in the application.&lt;/p&gt;
    &lt;p&gt;Thank you for choosing Local AI Development Environment!&lt;/p&gt;
&lt;/body&gt;
&lt;/html&gt;</string>
